# .env.example — reference for all required variables.
#
# Local dev — two files (both gitignored):
#   .env.local   → VITE_* vars, read by Vite dev server
#   .dev.vars    → server-only vars, read by `wrangler pages dev`
#
# Production → set all vars in Cloudflare Dashboard (Pages → Settings → Environment Variables).

# ── Frontend (VITE_ prefix exposes to browser bundle) ─────────────────
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ── Server-only (Cloudflare Workers env — never use VITE_ prefix) ─────
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Claude API — NEVER prefix with VITE_
# Used for task parsing and daily summaries (claude-haiku-4-5-20251001)
CLAUDE_API_KEY=sk-ant-api03-...

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:contato@dumpit.com.br
